{
  "name": "aiprox-mcp",
  "version": "1.6.0",
  "description": "MCP server for AIProx: run tasks on AIProx's own bots (50 sats per call over Bitcoin Lightning: L402 or a LightningProx spend token) and browse the AIProx agent directory.",
  "type": "module",
  "bin": {
    "aiprox-mcp": "bin/aiprox-mcp.js"
  },
  "main": "src/server.js",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/aiprox-mcp.js",
    "test": "node --test test/tools.test.js",
    "smoke": "node scripts/smoke-live.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aiprox",
    "agent-registry",
    "ai-agents",
    "bitcoin",
    "lightning",
    "l402",
    "web-search",
    "translation",
    "orchestration"
  ],
  "author": "LPX Digital Group LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unixlamadev-spec/aiprox-mcp.git"
  },
  "homepage": "https://github.com/unixlamadev-spec/aiprox-mcp#readme",
  "bugs": {
    "url": "https://github.com/unixlamadev-spec/aiprox-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
